# backend service base url, prod environment
VITE_SERVICE_BASE_URL=/api

# other backend service base url, prod environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9529"
}`

# ============ 以下变量需与 .env 保持一致（生产构建必需） ============
VITE_BASE_URL=/
VITE_APP_TITLE=Worker Mailer
VITE_APP_DESC=邮件发送服务后台管理

# icon 前缀
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local

# auth route mode: static ｜ dynamic
VITE_AUTH_ROUTE_MODE=static

# static auth route home
VITE_ROUTE_HOME=home

# default menu icon
VITE_MENU_ICON=mdi:menu

# vue-router mode
VITE_ROUTER_HISTORY_MODE=history

# success code of backend service
VITE_SERVICE_SUCCESS_CODE=0000
VITE_SERVICE_LOGOUT_CODES=8888,8889
VITE_SERVICE_MODAL_LOGOUT_CODES=7777,7778
VITE_SERVICE_EXPIRED_TOKEN_CODES=9999,9998,3333

# static super role
VITE_STATIC_SUPER_ROLE=R_SUPER

# sourcemap
VITE_SOURCE_MAP=N

# storage prefix
VITE_STORAGE_PREFIX=SOY_

# automatically detect update
VITE_AUTOMATICALLY_DETECT_UPDATE=N

# proxy log
VITE_PROXY_LOG=N