{
  "name": "worker-mailer",
  "version": "1.0.0",
  "description": "邮件发送服务 - 可替代 Resend 的邮件服务",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "pinia": "^3.0.4",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "worker-mailer": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240903.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.0.0"
  }
}
